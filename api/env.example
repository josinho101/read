# Flask
FLASK_DEBUG=1

# Storage backend - set to "local-disk" or "firebase"
# local-disk: save engine designs as JSON files on disk (default)
# firebase:   save engine designs to a Firestore collection
STORAGE_TYPE=local-disk

# --- local-disk backend ---
ENGINE_STORAGE_PATH=./saved_engines

# --- firebase backend ---
FIRESTORE_COLLECTION=engines
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
